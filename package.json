{
  "name": "curso-automatizacion",
  "private": true,
  "version": "0.1.0",
  "description": "Repositorio base del curso de Automatizacion de Pruebas - Grupo 2 (Banca), 5 grupos.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:api": "newman run \"postman/aiquaa Sandbox API.json\" -e postman/local.postman_environment.json",
    "test:practica": "newman run \"postman/practica/Practica - Sandbox API v2.postman_collection.json\" -e postman/practica/practica-v2.postman_environment.json --env-var \"apiKey=$API_KEY\" --delay-request 2500",
    "test:api:grupo-03": "newman run \"grupos/grupo-03-prestamos/postman/Grupo 03 - Prestamos.postman_collection.json\" -e \"grupos/grupo-03-prestamos/postman/grupo-03-prestamos.postman_environment.json\" --reporters cli,json --reporter-json-export \"newman/grupo-03/newman-results.json\" --delay-request 1500",
    "test:api:grupo-05-01": "node scripts/run-grupo-05-01-api.cjs",
    "test:bdd": "cucumber-js",
    "test:bdd:sandbox": "cucumber-js --config tests/bdd/sandbox-pom/cucumber.js --profile sandbox",
    "test:bdd:dryrun": "cucumber-js --config tests/bdd/sandbox-pom/cucumber.js --profile dryrun",
    "test:bdd:check": "node scripts/check-cucumber-results.mjs results/cucumber.json",
    "test:bdd:check:default": "node scripts/check-cucumber-results.mjs results/cucumber-report.json",
    "smoke": "playwright test --grep @smoke",
    "verify": "npm run test:bdd && npm run test:bdd:check:default && npm run test:e2e"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "@playwright/test": "^1.54.2",
    "allure-commandline": "^2.34.0",
    "allure-cucumberjs": "^3.3.0",
    "allure-playwright": "^3.3.0",
    "dotenv": "^17.2.3",
    "newman": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
