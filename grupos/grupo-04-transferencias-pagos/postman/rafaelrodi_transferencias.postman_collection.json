    {
      "name": "99 - Limpieza del fixture",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Vacia y da de baja las cuentas del fixture antes de borrar el cliente.",
              "// Una bloqueada vuelve a activa para poder debitarla; una cerrada ya tiene saldo 0.",
              "var variables = [\"cuentaPropiaOrigenId\", \"cuentaPropiaDestinoId\", \"cuentaSaldoBajoId\", \"cuentaDestinoOtroId\", \"cuentaBloqueadaId\", \"cuentaCerradaId\"];",
              "utils.secuencia(variables.map(function (v) {",
              "  return function (next) {",
              "    var id = pm.collectionVariables.get(v);",
              "    if (!id) { return next(); }",
              "    pm.sendRequest(utils.req(\"GET\", \"/api/v2/cuentas/\" + id), function (e, r) {",
              "      if (e || r.code !== 200) { return next(); }",
              "      var cta = r.json().data;",
              "      var pasos = [];",
              "      if (cta.estado === \"bloqueada\") {",
              "        pasos.push(function (n) { pm.sendRequest(utils.req(\"PATCH\", \"/api/v2/cuentas/\" + id + \"/estado\", { estado: \"activa\" }), function () { n(); }); });",
              "      }",
              "      if (cta.estado !== \"cerrada\" && Number(cta.saldo) > 0) {",
              "        pasos.push(function (n) { pm.sendRequest(utils.req(\"POST\", \"/api/v2/cuentas/\" + id + \"/movimientos\", { tipo: \"debito\", monto: Number(cta.saldo), descripcion: \"Limpieza fixture G04\" }), function () { n(); }); });",
              "      }",
              "      pasos.push(function (n) { pm.sendRequest(utils.req(\"DELETE\", \"/api/v2/cuentas/\" + id), function (e2, r2) { pm.collectionVariables.set(\"limpieza_\" + v, r2 ? r2.code : \"error\"); n(); }); });",
              "      utils.secuencia(pasos, next);",
              "    });",
              "  };",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cliente del fixture dado de baja\", function () { pm.response.to.have.status(204); });",
              "pm.test(\"Cuentas del fixture dadas de baja\", function () {",
              "  [\"cuentaPropiaOrigenId\", \"cuentaPropiaDestinoId\", \"cuentaSaldoBajoId\", \"cuentaDestinoOtroId\", \"cuentaBloqueadaId\", \"cuentaCerradaId\"].forEach(function (v) {",
              "    pm.expect(Number(pm.collectionVariables.get(\"limpieza_\" + v)), v).to.eql(204);",
              "  });",
              "});"
            ]
          }
        }
