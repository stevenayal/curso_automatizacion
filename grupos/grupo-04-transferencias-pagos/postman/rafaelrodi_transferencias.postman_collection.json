{
  "info": {
    "name": "rafaelrodi_transferencias",
    "description": "Escenarios BDD del grupo 4 (Transferencias) mapeados a POST /api/v2/transferencias, con validaciones de respuesta y de BD via /api/v2/sql/select. Ver docs/trazabilidad-bdd-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request de la coleccion: helpers reutilizables (sandbox curso 2).",
          "// pm.variables resuelve primero el entorno: la apiKey llega por --env-var o el environment, nunca commiteada.",
          "if (typeof utils === \"undefined\") {",
          "  utils = {",
          "    req: function (method, ruta, body) {",
          "      var r = {",
          "        url: pm.variables.get(\"baseUrl\") + ruta,",
          "        method: method,",
          "        header: { \"Content-Type\": \"application/json\", \"x-api-key\": pm.variables.get(\"apiKey\") }",
          "      };",
          "      if (body !== undefined) { r.body = { mode: \"raw\", raw: JSON.stringify(body) }; }",
          "      return r;",
          "    },",
          "    sql: function (sql, params) {",
          "      return utils.req(\"POST\", \"/api/v2/sql/select\", { sql: sql, params: params || [] });",
          "    },",
          "    // Ejecuta pasos asincronos (cada uno recibe \"next\") uno detras de otro.",
          "    secuencia: function (pasos, fin) {",
          "      var i = 0;",
          "      (function siguiente() {",
          "        if (i >= pasos.length) { if (fin) { fin(); } return; }",
          "        pasos[i++](siguiente);",
          "      })();",
          "    }",
          "  };",
          "}",
          "",
          "// Los datos de prueba los crea \"00 - Fixture\" (cliente aislado, issue #28) y los borra",
          "// \"99 - Limpieza\": ningun escenario usa ni modifica cuentas compartidas del seed."
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://aiquaa-sandbox-api.vercel.app",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaPropiaOrigenId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaPropiaDestinoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaBloqueadaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaCerradaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaSaldoBajoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaDestinoOtroId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaInexistenteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaOrigenId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cuentaDestinoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "monto",
      "value": "25000",
      "type": "string"
    },
    {
      "key": "concepto",
      "value": "",
      "type": "string"
    },
    {
