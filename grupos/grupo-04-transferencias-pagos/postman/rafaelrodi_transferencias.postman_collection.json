{
  "info": {
    "name": "rafaelrodi_transferencias",
    "description": "Escenarios BDD del grupo 4 (Transferencias) mapeados a POST /api/v2/transferencias, con validaciones de respuesta y de BD via /api/v2/sql/select. Ver docs/trazabilidad-bdd-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request de la coleccion: helper SQL reutilizable (sandbox curso 2).",
          "if (typeof utils === \"undefined\") {",
          "  utils = {",
          "    sql: function (sql, params) {",
          "      return {",
          "        url: pm.collectionVariables.get(\"baseUrl\") + \"/api/v2/sql/select\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/json\", \"x-api-key\": pm.collectionVariables.get(\"apiKey\") },",
          "        body: { mode: \"raw\", raw: JSON.stringify({ sql: sql, params: params || [] }) }",
          "      };",
          "    }",
          "  };",
          "}",
          "",
          "// Descubrimiento dinamico de cuentas: UNA sola consulta a la BD y la eleccion se",
          "// hace en JS. Se cachea 60 s (una corrida completa dura ~7 s) para no gastar",
          "// requests del rate limit (30/min) en cada item.",
          "var TTL_MS = 60000;",
          "var vigente = Number(pm.collectionVariables.get(\"descubiertoEn\") || 0) > Date.now() - TTL_MS;",
          "if (!vigente) {",
          "  pm.sendRequest(utils.sql(\"SELECT * FROM cuentas ORDER BY id\", []), function (err, res) {",
          "    if (err || res.code !== 200) {",
          "      throw new Error(\"No se pudieron consultar las cuentas para armar los datos de prueba: \" + (err || res.code));",
          "    }",
          "    var cuentas = res.json().data.map(function (c) {",
          "      return { id: Number(c.id), usuario: Number(c.usuario_id), moneda: c.moneda, saldo: Number(c.saldo), estado: c.estado, activa: c.activa };",
          "    });",
          "    var activas = cuentas.filter(function (c) { return c.estado === \"activa\" && c.activa; });",
          "",
          "    // Cuentas propias: mismo usuario y misma moneda, origen con saldo (el de mayor saldo).",
          "    var par = null;",
          "    activas.slice().sort(function (a, b) { return b.saldo - a.saldo; }).some(function (o) {",
          "      var d = activas.filter(function (x) { return x.id !== o.id && x.usuario === o.usuario && x.moneda === o.moneda; })[0];",
          "      if (o.saldo >= 1 && d) { par = { o: o, d: d }; return true; }",
          "    });",
          "    // Saldo bajo: la cuenta activa con menos saldo (que no sea el origen propio) + otro destino activo.",
          "    var pobre = activas.filter(function (c) { return !par || c.id !== par.o.id; })",
          "                       .sort(function (a, b) { return a.saldo - b.saldo; })[0];",
          "    var destinoDePobre = pobre && activas.filter(function (c) { return c.id !== pobre.id; })[0];",
          "    var bloqueada = cuentas.filter(function (c) { return c.estado === \"bloqueada\"; })[0];",
          "    var cerrada = cuentas.filter(function (c) { return c.estado === \"cerrada\"; })[0];",
          "",
          "    var faltan = [];",
          "    if (!par) faltan.push(\"dos cuentas activas del mismo usuario/moneda con saldo\");",
          "    if (!pobre || !destinoDePobre) faltan.push(\"una cuenta activa de saldo bajo + otro destino activo\");",
          "    if (!bloqueada) faltan.push(\"una cuenta bloqueada\");",
          "    if (!cerrada) faltan.push(\"una cuenta cerrada\");",
          "    if (faltan.length) { throw new Error(\"El estado actual de la BD no permite armar los escenarios. Falta: \" + faltan.join(\"; \")); }",
          "",
          "    var maxId = Math.max.apply(null, cuentas.map(function (c) { return c.id; }));",
          "    pm.collectionVariables.set(\"cuentaPropiaOrigenId\", par.o.id);",
          "    pm.collectionVariables.set(\"cuentaPropiaDestinoId\", par.d.id);",
          "    pm.collectionVariables.set(\"cuentaSaldoBajoId\", pobre.id);",
          "    pm.collectionVariables.set(\"cuentaDestinoOtroId\", destinoDePobre.id);",
          "    pm.collectionVariables.set(\"cuentaBloqueadaId\", bloqueada.id);",
          "    pm.collectionVariables.set(\"cuentaCerradaId\", cerrada.id);",
          "    pm.collectionVariables.set(\"cuentaInexistenteId\", maxId + 1000);",
          "    pm.collectionVariables.set(\"descubiertoEn\", Date.now());",
          "  });",
          "}",
          ""
        ]
      }
    }
  ],
