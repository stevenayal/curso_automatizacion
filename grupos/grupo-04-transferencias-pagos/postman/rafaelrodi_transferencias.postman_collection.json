              "});",
              "",
              "pm.test('El error es VALIDATION_ERROR y el mensaje es el esperado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.undefined;",
              "    pm.expect(jsonData.error.code).to.eql('VALIDATION_ERROR');",
              "    pm.expect(jsonData.error.message).to.match(/no puede ser la misma/i);",
              "});",
              "",
              "// Validacion contra la BD: no se registro la transferencia y no se desconto el monto.",
              "const origen = Number(pm.collectionVariables.get(\"cuentaOrigenId\"));",
              "const concepto = pm.collectionVariables.get(\"concepto\");",
              "pm.sendRequest(utils.sql(\"SELECT id FROM transferencias WHERE concepto = $1\", [concepto]), function (err, res) {",
              "    pm.test('La transferencia NO queda registrada en la BD', function () {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res.json().data.length).to.eql(0);",
              "    });",
              "});",
              "pm.sendRequest(utils.sql(\"SELECT saldo FROM cuentas WHERE id = $1\", [origen]), function (err, res) {",
              "    pm.test('El saldo de la cuenta origen no se modifico', function () {",
              "        pm.expect(Number(res.json().data[0].saldo)).to.eql(Number(pm.collectionVariables.get(\"saldoPrevio_\" + origen)));",
              "    });",
              "});"
            ]
