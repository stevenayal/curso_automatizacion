    {
      "key": "fixtureSufijo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Fixture: cliente aislado con sus cuentas",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"fixtureSufijo\", Date.now() + \"\" + Math.floor(Math.random() * 1000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cliente aislado creado\", function () { pm.response.to.have.status(201); });",
              "var usuarioId = pm.response.json().data.id;",
              "pm.collectionVariables.set(\"fixtureUsuarioId\", usuarioId);",
              "pm.collectionVariables.set(\"cuentaInexistenteId\", 999999999);",
              "",
              "// Cada cuenta se abre, se fondea con un movimiento y despues se le aplica el estado",
              "// (una cuenta bloqueada o cerrada ya no admite movimientos).",
              "function cuenta(variable, saldo, estado) {",
              "  return function (next) {",
              "    pm.sendRequest(utils.req(\"POST\", \"/api/v2/cuentas\", { usuarioId: usuarioId, tipoCuenta: \"ahorro\", moneda: \"PYG\" }), function (err, res) {",
              "      if (err || res.code !== 201) { throw new Error(\"No se pudo abrir \" + variable + \": \" + (err || res.text())); }",
              "      var id = res.json().data.id;",
              "      pm.collectionVariables.set(variable, id);",
              "      var pasos = [];",
              "      if (saldo > 0) {",
              "        pasos.push(function (n) {",
              "          pm.sendRequest(utils.req(\"POST\", \"/api/v2/cuentas/\" + id + \"/movimientos\", { tipo: \"credito\", monto: saldo, descripcion: \"Fondeo fixture G04\" }), function (e, r) {",
              "            if (e || r.code !== 201) { throw new Error(\"No se pudo fondear \" + variable + \": \" + (e || r.text())); }",
              "            n();",
              "          });",
              "        });",
              "      }",
              "      if (estado) {",
              "        pasos.push(function (n) {",
              "          pm.sendRequest(utils.req(\"PATCH\", \"/api/v2/cuentas/\" + id + \"/estado\", { estado: estado }), function (e, r) {",
              "            if (e || r.code !== 200) { throw new Error(\"No se pudo pasar \" + variable + \" a \" + estado + \": \" + (e || r.text())); }",
              "            n();",
              "          });",
              "        });",
              "      }",
              "      utils.secuencia(pasos, next);",
              "    });",
              "  };",
              "}",
              "",
              "utils.secuencia([",
              "  cuenta(\"cuentaPropiaOrigenId\", 1000000),",
              "  cuenta(\"cuentaPropiaDestinoId\", 0),",
              "  cuenta(\"cuentaSaldoBajoId\", 1000),",
              "  cuenta(\"cuentaDestinoOtroId\", 0),",
              "  cuenta(\"cuentaBloqueadaId\", 0, \"bloqueada\"),",
              "  cuenta(\"cuentaCerradaId\", 0, \"cerrada\")",
              "], function () {",
              "  pm.test(\"Fixture listo: 6 cuentas del cliente \" + usuarioId, function () {",
              "    pm.expect(Number(pm.collectionVariables.get(\"cuentaCerradaId\"))).to.be.above(0);",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"G04 Fixture Postman {{fixtureSufijo}}\",\n  \"email\": \"g04.postman.{{fixtureSufijo}}@aiquaa.test\",\n  \"documentoTipo\": \"CI\",\n  \"documentoNumero\": \"G04P{{fixtureSufijo}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "usuarios"
          ]
        }
      }
    },
    {
      "name": "BDD 1 - Transferencia entre cuentas propias [@happy-path]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Datos del escenario + snapshot del estado ANTES de transferir.",
              "const escenario = \"happy-path\";",
              "pm.collectionVariables.set(\"cuentaOrigenId\", Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")));",
              "pm.collectionVariables.set(\"cuentaDestinoId\", Number(pm.collectionVariables.get(\"cuentaPropiaDestinoId\")));",
              "// concepto unico por corrida: permite buscar SOLO esta transferencia en la BD",
              "pm.collectionVariables.set(\"concepto\", \"BDD-\" + escenario + \"-\" + Date.now());",
              "",
              "// El monto se calcula con el saldo REAL de la BD (pm.sendRequest es asincrono",
              "// pero Postman/newman esperan al callback antes de enviar el request).",
              "pm.sendRequest(",
              "  utils.sql(\"SELECT id, saldo FROM cuentas WHERE id IN ($1, $2) ORDER BY id\", [Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")), Number(pm.collectionVariables.get(\"cuentaPropiaDestinoId\"))]),",
              "  function (err, res) {",
              "    if (err) { throw err; }",
              "    var filas = res.json().data;",
              "    filas.forEach(function (c) {",
              "      pm.collectionVariables.set(\"saldoPrevio_\" + c.id, Number(c.saldo));",
              "    });",
              "    var saldoOrigen = Number(pm.collectionVariables.get(\"saldoPrevio_\" + Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\"))));",
              "    // happy path: el monto se ajusta al saldo real (max 25000) para que siempre alcance",
              "    var monto = Math.min(25000, Math.floor(saldoOrigen));",
              "    if (monto < 1) { throw new Error('La cuenta origen ' + Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")) + ' no tiene saldo para el happy path: recargarla o cambiar cuentaPropiaOrigenId'); }",
              "    pm.collectionVariables.set(\"monto\", monto);",
              "  }",
              ");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response time is less than 3000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test('Status 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('La transferencia queda registrada en estado exitoso (completada)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.estado).to.eql('completada');",
              "    pm.expect(jsonData.data.cuenta_origen_id).to.eql(Number(pm.collectionVariables.get(\"cuentaOrigenId\")));",
              "    pm.expect(jsonData.data.cuenta_destino_id).to.eql(Number(pm.collectionVariables.get(\"cuentaDestinoId\")));",
              "    pm.expect(Number(jsonData.data.monto)).to.eql(Number(pm.collectionVariables.get(\"monto\")));",
              "    pm.expect(jsonData.data.referencia).to.match(/^TRF-/);",
              "});",
              "",
              "pm.test('Los saldos devueltos reflejan debito y credito', function () {",
              "    var d = pm.response.json().data;",
              "    var monto = Number(pm.collectionVariables.get(\"monto\"));",
              "    pm.expect(Number(d.cuenta_origen.saldo)).to.eql(Number(pm.collectionVariables.get(\"saldoPrevio_\" + d.cuenta_origen_id)) - monto);",
              "    pm.expect(Number(d.cuenta_destino.saldo)).to.eql(Number(pm.collectionVariables.get(\"saldoPrevio_\" + d.cuenta_destino_id)) + monto);",
              "});",
              "",
              "// Validacion contra la BD: la transferencia existe y esta completada.",
              "const concepto = pm.collectionVariables.get(\"concepto\");",
              "pm.sendRequest(utils.sql(\"SELECT estado, monto FROM transferencias WHERE concepto = $1\", [concepto]), function (err, res) {",
              "    pm.test('La BD tiene UNA transferencia completada con ese concepto', function () {",
              "        var filas = res.json().data;",
              "        pm.expect(filas.length).to.eql(1);",
              "        pm.expect(filas[0].estado).to.eql('completada');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Dado dos cuentas activas del mismo cliente (usuario 1: cuentas 1 y 16, PYG) con saldo suficiente. Cuando transfiere un importe valido. Entonces queda 'completada' (201).",
        "url": {
          "raw": "{{baseUrl}}/api/v2/transferencias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "transferencias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cuentaOrigenId\": {{cuentaOrigenId}},\n  \"cuentaDestinoId\": {{cuentaDestinoId}},\n  \"monto\": {{monto}},\n  \"concepto\": \"{{concepto}}\"\n}"
        }
      }
    },
    {
      "name": "BDD 2 - Misma cuenta origen y destino [@negativo]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Datos del escenario + snapshot del estado ANTES de transferir.",
              "const escenario = \"misma-cuenta\";",
              "pm.collectionVariables.set(\"cuentaOrigenId\", Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")));",
              "pm.collectionVariables.set(\"cuentaDestinoId\", Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")));",
              "// concepto unico por corrida: permite buscar SOLO esta transferencia en la BD",
              "pm.collectionVariables.set(\"concepto\", \"BDD-\" + escenario + \"-\" + Date.now());",
              "",
              "// El monto se calcula con el saldo REAL de la BD (pm.sendRequest es asincrono",
              "// pero Postman/newman esperan al callback antes de enviar el request).",
              "pm.sendRequest(",
              "  utils.sql(\"SELECT id, saldo FROM cuentas WHERE id IN ($1, $2) ORDER BY id\", [Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")), Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\"))]),",
              "  function (err, res) {",
              "    if (err) { throw err; }",
              "    var filas = res.json().data;",
              "    filas.forEach(function (c) {",
              "      pm.collectionVariables.set(\"saldoPrevio_\" + c.id, Number(c.saldo));",
              "    });",
              "    var saldoOrigen = Number(pm.collectionVariables.get(\"saldoPrevio_\" + Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\"))));",
              "    // happy path: el monto se ajusta al saldo real (max 25000) para que siempre alcance",
              "    var monto = Math.min(25000, Math.floor(saldoOrigen));",
              "    if (monto < 1) { throw new Error('La cuenta origen ' + Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")) + ' no tiene saldo para el happy path: recargarla o cambiar cuentaPropiaOrigenId'); }",
              "    pm.collectionVariables.set(\"monto\", monto);",
              "  }",
              ");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response time is less than 3000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test('El sistema rechaza la operacion con HTTP 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('El error es VALIDATION_ERROR y el mensaje es el esperado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.undefined;",
              "    pm.expect(jsonData.error.code).to.eql('VALIDATION_ERROR');",
              "    pm.expect(jsonData.error.message).to.match(/no puede ser la misma/i);",
              "});",
              "",
              "// Validacion contra la BD: no se registro la transferencia y no se desconto el monto.",
              "const origen = Number(pm.collectionVariables.get(\"cuentaOrigenId\"));",
              "const concepto = pm.collectionVariables.get(\"concepto\");",
              "pm.sendRequest(utils.sql(\"SELECT id FROM transferencias WHERE concepto = $1\", [concepto]), function (err, res) {",
              "    pm.test('La transferencia NO queda registrada en la BD', function () {",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res.json().data.length).to.eql(0);",
              "    });",
              "});",
              "pm.sendRequest(utils.sql(\"SELECT saldo FROM cuentas WHERE id = $1\", [origen]), function (err, res) {",
              "    pm.test('El saldo de la cuenta origen no se modifico', function () {",
              "        pm.expect(Number(res.json().data[0].saldo)).to.eql(Number(pm.collectionVariables.get(\"saldoPrevio_\" + origen)));",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Dado una cuenta activa. Cuando transfiere a si misma. Entonces 400 VALIDATION_ERROR y no se registra.",
        "url": {
          "raw": "{{baseUrl}}/api/v2/transferencias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "transferencias"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cuentaOrigenId\": {{cuentaOrigenId}},\n  \"cuentaDestinoId\": {{cuentaDestinoId}},\n  \"monto\": {{monto}},\n  \"concepto\": \"{{concepto}}\"\n}"
        }
      }
    },
    {
      "name": "BDD 3 - Destino bloqueada [@edge-case]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Datos del escenario + snapshot del estado ANTES de transferir.",
              "const escenario = \"destino-bloqueada\";",
              "pm.collectionVariables.set(\"cuentaOrigenId\", Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")));",
              "pm.collectionVariables.set(\"cuentaDestinoId\", Number(pm.collectionVariables.get(\"cuentaBloqueadaId\")));",
              "// concepto unico por corrida: permite buscar SOLO esta transferencia en la BD",
              "pm.collectionVariables.set(\"concepto\", \"BDD-\" + escenario + \"-\" + Date.now());",
              "",
              "// El monto se calcula con el saldo REAL de la BD (pm.sendRequest es asincrono",
              "// pero Postman/newman esperan al callback antes de enviar el request).",
              "pm.sendRequest(",
              "  utils.sql(\"SELECT id, saldo FROM cuentas WHERE id IN ($1, $2) ORDER BY id\", [Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")), Number(pm.collectionVariables.get(\"cuentaBloqueadaId\"))]),",
              "  function (err, res) {",
              "    if (err) { throw err; }",
