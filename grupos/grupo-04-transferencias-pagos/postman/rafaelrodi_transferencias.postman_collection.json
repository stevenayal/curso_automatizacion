  "item": [
    {
      "name": "BDD 1 - Transferencia entre cuentas propias [@happy-path]",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Datos del escenario + snapshot del estado ANTES de transferir.",
              "const escenario = \"happy-path\";",
              "pm.collectionVariables.set(\"cuentaOrigenId\", Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")));",
              "pm.collectionVariables.set(\"cuentaDestinoId\", Number(pm.collectionVariables.get(\"cuentaPropiaDestinoId\")));",
              "// concepto unico por corrida: permite buscar SOLO esta transferencia en la BD",
              "pm.collectionVariables.set(\"concepto\", \"BDD-\" + escenario + \"-\" + Date.now());",
              "",
              "// El monto se calcula con el saldo REAL de la BD (pm.sendRequest es asincrono",
              "// pero Postman/newman esperan al callback antes de enviar el request).",
              "pm.sendRequest(",
              "  utils.sql(\"SELECT id, saldo FROM cuentas WHERE id IN ($1, $2) ORDER BY id\", [Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")), Number(pm.collectionVariables.get(\"cuentaPropiaDestinoId\"))]),",
              "  function (err, res) {",
              "    if (err) { throw err; }",
              "    var filas = res.json().data;",
              "    filas.forEach(function (c) {",
              "      pm.collectionVariables.set(\"saldoPrevio_\" + c.id, Number(c.saldo));",
              "    });",
              "    var saldoOrigen = Number(pm.collectionVariables.get(\"saldoPrevio_\" + Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\"))));",
              "    // happy path: el monto se ajusta al saldo real (max 25000) para que siempre alcance",
              "    var monto = Math.min(25000, Math.floor(saldoOrigen));",
              "    if (monto < 1) { throw new Error('La cuenta origen ' + Number(pm.collectionVariables.get(\"cuentaPropiaOrigenId\")) + ' no tiene saldo para el happy path: recargarla o cambiar cuentaPropiaOrigenId'); }",
              "    pm.collectionVariables.set(\"monto\", monto);",
              "  }",
              ");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Response time is less than 3000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "",
              "pm.test('Status 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('La transferencia queda registrada en estado exitoso (completada)', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.estado).to.eql('completada');",
              "    pm.expect(jsonData.data.cuenta_origen_id).to.eql(Number(pm.collectionVariables.get(\"cuentaOrigenId\")));",
              "    pm.expect(jsonData.data.cuenta_destino_id).to.eql(Number(pm.collectionVariables.get(\"cuentaDestinoId\")));",
              "    pm.expect(Number(jsonData.data.monto)).to.eql(Number(pm.collectionVariables.get(\"monto\")));",
              "    pm.expect(jsonData.data.referencia).to.match(/^TRF-/);",
              "});",
              "",
              "pm.test('Los saldos devueltos reflejan debito y credito', function () {",
              "    var d = pm.response.json().data;",
              "    var monto = Number(pm.collectionVariables.get(\"monto\"));",
              "    pm.expect(Number(d.cuenta_origen.saldo)).to.eql(Number(pm.collectionVariables.get(\"saldoPrevio_\" + d.cuenta_origen_id)) - monto);",
              "    pm.expect(Number(d.cuenta_destino.saldo)).to.eql(Number(pm.collectionVariables.get(\"saldoPrevio_\" + d.cuenta_destino_id)) + monto);",
              "});",
              "",
              "// Validacion contra la BD: la transferencia existe y esta completada.",
              "const concepto = pm.collectionVariables.get(\"concepto\");",
              "pm.sendRequest(utils.sql(\"SELECT estado, monto FROM transferencias WHERE concepto = $1\", [concepto]), function (err, res) {",
              "    pm.test('La BD tiene UNA transferencia completada con ese concepto', function () {",
              "        var filas = res.json().data;",
              "        pm.expect(filas.length).to.eql(1);",
              "        pm.expect(filas[0].estado).to.eql('completada');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
