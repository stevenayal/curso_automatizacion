	"item": [
		{
			"name": "New Request",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"pm.test(\"Response status code is 200\", function () {\r",
							"    pm.expect(pm.response.code).to.eql(200);\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Response contains required fields\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData.data).to.be.an('array').that.is.not.empty;\r",
							"\r",
							"    responseData.data.forEach(function(item) {\r",
							"        pm.expect(item).to.have.all.keys('id', 'usuario_id', 'numero_cuenta', 'tipo_cuenta', 'moneda', 'saldo', 'estado', 'activa', 'created_at');\r",
							"    });\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Saldo must be a valid numeric value\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData.data).to.be.an('array').that.is.not.empty;\r",
							"    \r",
							"    responseData.data.forEach(function(account) {\r",
							"        pm.expect(account.saldo).to.satisfy(function(value) {\r",
							"            return !isNaN(value) && typeof value === 'number';\r",
							"        }, \"Saldo should be a valid numeric value\");\r",
							"    });\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Created_at is in a valid date format\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData.data).to.be.an('array').that.is.not.empty;\r",
							"\r",
							"    responseData.data.forEach(item => {\r",
							"        pm.expect(item.created_at).to.exist;\r",
							"        pm.expect(new Date(item.created_at).getTime()).to.not.be.NaN;\r",
							"    });\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"The 'activa' field must be a boolean value\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.have.property('data').that.is.an('array').with.length.of.at.least(1);\r",
							"    responseData.data.forEach(function(item) {\r",
							"        pm.expect(item).to.have.property('activa').that.is.a('boolean');\r",
							"    });\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
