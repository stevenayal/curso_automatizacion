							"    );\r",
							"});\r",
							"\r",
							"pm.test(\"Debe devolver los datos principales de la cuenta\", function () {\r",
							"    const respuesta = pm.response.json();\r",
							"\r",
							"    pm.expect(respuesta.data).to.have.property(\"numero_cuenta\");\r",
