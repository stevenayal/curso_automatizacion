		{
			"name": "ABRIR CUENTA - GRUPO 1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Debe crear la cuenta correctamente\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Debe crear la cuenta con los datos solicitados\", function () {\r",
							"    const respuesta = pm.response.json();\r",
							"\r",
							"    pm.expect(respuesta.data.usuario_id).to.eql(\r",
							"        Number(pm.collectionVariables.get(\"usuario_id\"))\r",
							"    );\r",
							"\r",
							"    pm.expect(respuesta.data.tipo_cuenta).to.eql(\r",
							"        pm.collectionVariables.get(\"tipo_cuenta\")\r",
							"    );\r",
							"\r",
							"    pm.expect(respuesta.data.moneda).to.eql(\r",
							"        pm.collectionVariables.get(\"moneda\")\r",
							"    );\r",
							"});\r",
							"\r",
							"pm.test(\"Debe devolver un ID de cuenta valido\", function () {\r",
							"    const respuesta = pm.response.json();\r",
							"\r",
							"    pm.expect(respuesta.data.id).to.be.a(\"number\");\r",
							"    pm.expect(respuesta.data.id).to.be.above(0);\r",
							"\r",
							"    pm.collectionVariables.set(\"cuenta_id\", respuesta.data.id);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
