		{
			"name": "LISTAR CUENTA - GRUPO 1",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Debe responder HTTP 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Debe devolver una lista de cuentas\", function () {\r",
							"    const respuesta = pm.response.json();\r",
							"\r",
							"    pm.expect(respuesta.data).to.be.an(\"array\");\r",
							"    pm.expect(respuesta.data.length).to.be.above(0);\r",
							"});\r",
							"\r",
							"pm.test(\"Todas las cuentas deben tener el estado solicitado\", function () {\r",
							"    const respuesta = pm.response.json();\r",
							"    const estadoEsperado = pm.collectionVariables.get(\"estado_cuenta\");\r",
							"\r",
							"    respuesta.data.forEach(function (cuenta) {\r",
							"        pm.expect(cuenta.estado).to.eql(estadoEsperado);\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
