    {
      "name": "E2E - Flujos con validacion SQL",
      "description": "Patron SQL REST dinamico sobre POST /api/v2/depositos y POST /api/v2/depositos/{id}/cancelar. Correr la carpeta completa y en orden.",
      "item": [
        {
          "name": "Constituir deposito (INSERT + validacion SQL)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 0) Se limpia el id de una corrida anterior: si este POST falla, los",
                  "//    requests de cancelacion no deben reusar un deposito viejo.",
                  "pm.collectionVariables.unset(\"depositoCreadoId\");",
                  "",
                  "// 1) Caso feliz: NO sobreescribe nada, usa los defaults de la coleccion.",
                  "// 2) Precondicion en la BD: la cuenta esta activa y tiene saldo suficiente.",
                  "//    Se guardan saldo y COUNT(*) ANTES para comparar en el Test.",
                  "const cuentaId = Number(pm.collectionVariables.get(\"cuentaId\"));",
                  "const monto = Number(pm.collectionVariables.get(\"monto\"));",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT saldo, estado, (SELECT COUNT(*) FROM depositos) AS total_depositos FROM cuentas WHERE id = $1\",",
                  "  [cuentaId]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  if (err) { console.error(\"Pre-request SQL fallo:\", err); return; }",
                  "  const fila = (res.json().data || [])[0];",
                  "  if (!fila) { console.warn(\"La cuenta \" + cuentaId + \" no existe\"); return; }",
                  "  if (fila.estado !== \"activa\") { console.warn(\"Precondicion: la cuenta no esta activa (\" + fila.estado + \")\"); }",
                  "  if (Number(fila.saldo) < monto) { console.warn(\"Precondicion: saldo \" + fila.saldo + \" < monto \" + monto); }",
                  "  pm.variables.set(\"cuentaEstadoAntes\", fila.estado);",
                  "  pm.variables.set(\"saldoAntes\", fila.saldo);",
                  "  pm.variables.set(\"totalAntes\", fila.total_depositos);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Precondicion: la cuenta estaba activa y con saldo suficiente', function () {",
                  "    pm.expect(pm.variables.get('cuentaEstadoAntes')).to.eql('activa');",
                  "    pm.expect(Number(pm.variables.get('saldoAntes'))).to.be.at.least(Number(pm.collectionVariables.get('monto')));",
                  "});",
                  "",
                  "pm.test('status 201 - deposito constituido', function () { pm.response.to.have.status(201); });",
                  "",
                  "const respuesta = pm.response.json().data;",
                  "const monto = Number(pm.collectionVariables.get('monto'));",
                  "const plazoDias = Number(pm.collectionVariables.get('plazoDias'));",
                  "",
                  "pm.test('La respuesta trae el deposito creado y activo', function () {",
                  "    pm.expect(respuesta).to.have.property('id');",
                  "    pm.expect(respuesta.estado).to.eql('activo');",
                  "    pm.expect(utils.centavos(respuesta.monto)).to.eql(utils.centavos(monto));",
                  "    pm.expect(respuesta.plazo_dias).to.eql(plazoDias);",
                  "    pm.expect(respuesta.cuenta_id).to.eql(Number(pm.collectionVariables.get('cuentaId')));",
                  "});",
                  "",
                  "pm.test('El vencimiento es fecha_inicio + plazoDias', function () {",
                  "    const venc = new Date(respuesta.fecha_inicio + 'T00:00:00Z');",
                  "    venc.setUTCDate(venc.getUTCDate() + plazoDias);",
                  "    pm.expect(respuesta.fecha_vencimiento).to.eql(venc.toISOString().slice(0, 10));",
                  "});",
                  "",
                  "// Se guarda el id para encadenar la cancelacion (Escenario 4).",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('depositoCreadoId', respuesta.id);",
                  "}",
                  "",
                  "// 3) Relectura de la BD: la fila existe, la cuenta se debito y quedo el",
                  "//    movimiento de debito que referencia al deposito.",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT d.estado, d.monto, d.plazo_dias, c.saldo, \" +",
                  "  \"(SELECT COUNT(*) FROM depositos) AS total_depositos, \" +",
                  "  \"(SELECT COUNT(*) FROM movimientos m WHERE m.referencia_tipo = 'deposito' AND m.referencia_id = d.id AND m.tipo = 'debito') AS movimientos_debito \" +",
                  "  \"FROM depositos d JOIN cuentas c ON c.id = d.cuenta_id WHERE d.id = $1\",",
                  "  [respuesta.id]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  const fila = err ? undefined : (res.json().data || [])[0];",
                  "  pm.test(\"La BD confirma el deposito con estado 'activo'\", function () {",
                  "    pm.expect(fila, 'no se encontro la fila en la BD').to.not.be.undefined;",
                  "    pm.expect(fila.estado).to.eql('activo');",
                  "    pm.expect(utils.centavos(fila.monto)).to.eql(utils.centavos(monto));",
                  "    pm.expect(fila.plazo_dias).to.eql(plazoDias);",
                  "  });",
                  "  pm.test('La BD registro exactamente un deposito nuevo', function () {",
                  "    pm.expect(Number(fila.total_depositos)).to.eql(Number(pm.variables.get('totalAntes')) + 1);",
                  "  });",
                  "  pm.test('El saldo de la cuenta se debito por el monto del deposito', function () {",
                  "    pm.expect(utils.centavos(fila.saldo)).to.eql(utils.centavos(pm.variables.get('saldoAntes')) - utils.centavos(monto));",
                  "  });",
                  "  pm.test('Se registro el movimiento de debito del deposito', function () {",
                  "    pm.expect(Number(fila.movimientos_debito)).to.eql(1);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/depositos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "depositos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"cuentaId\": {{cuentaId}},\n  \"monto\": {{monto}},\n  \"plazoDias\": {{plazoDias}},\n  \"tasaAnual\": {{tasaAnual}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Caso feliz. Pre-request: valida en la BD que la cuenta esta activa y con saldo suficiente. Test: valida 201 y relee la BD (fila en depositos, debito en la cuenta y movimiento referenciado)."
          },
          "response": []
        },
        {
          "name": "Constituir deposito - plazo invalido (validacion negativa)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1) Caso negativo: sobreescribe UNA sola variable (plazo minimo es 30).",
                  "pm.collectionVariables.set(\"plazoDias\", 15);",
                  "",
                  "// 2) COUNT(*) y saldo ANTES, para confirmar despues que nada cambio.",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT saldo, (SELECT COUNT(*) FROM depositos) AS total_depositos FROM cuentas WHERE id = $1\",",
                  "  [Number(pm.collectionVariables.get(\"cuentaId\"))]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  if (err) { console.error(\"Pre-request SQL fallo:\", err); return; }",
                  "  const fila = res.json().data[0];",
                  "  pm.variables.set(\"saldoAntes\", fila.saldo);",
                  "  pm.variables.set(\"totalAntes\", fila.total_depositos);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400 (plazoDias por debajo del minimo)', function () { pm.response.to.have.status(400); });",
                  "pm.test('El error es VALIDATION_ERROR', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});",
                  "",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT saldo, (SELECT COUNT(*) FROM depositos) AS total_depositos FROM cuentas WHERE id = $1\",",
                  "  [Number(pm.collectionVariables.get(\"cuentaId\"))]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  pm.test('La BD no registro ningun deposito nuevo', function () {",
                  "    pm.expect(err).to.be.null;",
                  "    pm.expect(Number(res.json().data[0].total_depositos)).to.eql(Number(pm.variables.get('totalAntes')));",
                  "  });",
                  "  pm.test('El saldo de la cuenta no cambio', function () {",
                  "    pm.expect(utils.centavos(res.json().data[0].saldo)).to.eql(utils.centavos(pm.variables.get('saldoAntes')));",
                  "  });",
                  "});"
                ]
              }
            }
