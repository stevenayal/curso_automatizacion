        {
          "name": "Cancelar deposito creado (UPDATE + validacion SQL)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1) Precondicion en la BD: el deposito creado en este flujo sigue 'activo'",
                  "//    (solo se puede cancelar un deposito activo). Se guarda el saldo ANTES.",
                  "const id = Number(pm.collectionVariables.get(\"depositoCreadoId\"));",
                  "if (!id) {",
                  "  // Sin deposito creado en esta corrida no hay nada que cancelar.",
                  "  console.warn(\"depositoCreadoId vacio: fallo 'Constituir deposito'. Se omite el request.\");",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT d.estado, d.monto, c.saldo FROM depositos d JOIN cuentas c ON c.id = d.cuenta_id WHERE d.id = $1\",",
                  "  [id]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  if (err) { console.error(\"Pre-request SQL fallo:\", err); return; }",
                  "  const fila = (res.json().data || [])[0];",
                  "  if (!fila) { console.warn(\"No existe el deposito \" + id + \" (correr la carpeta completa)\"); return; }",
                  "  pm.variables.set(\"estadoAntes\", fila.estado);",
                  "  pm.variables.set(\"saldoAntes\", fila.saldo);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Precondicion: el deposito estaba 'activo' en la BD\", function () {",
                  "    pm.expect(pm.variables.get('estadoAntes')).to.eql('activo');",
                  "});",
                  "",
                  "pm.test('La cancelacion anticipada se procesa correctamente', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const respuesta = pm.response.json().data;",
                  "pm.test('Se cancela el deposito solicitado', function () {",
                  "    pm.expect(respuesta.id).to.eql(Number(pm.collectionVariables.get('depositoCreadoId')));",
                  "});",
                  "pm.test('El deposito queda en estado cancelado', function () {",
                  "    pm.expect(respuesta.estado).to.eql('cancelado');",
                  "});",
                  "pm.test('La respuesta contiene capital e intereses generados', function () {",
                  "    pm.expect(Number(respuesta.monto)).to.be.above(0);",
                  "    pm.expect(Number(respuesta.interes_generado)).to.be.at.least(0);",
                  "});",
                  "pm.test('El tiempo de respuesta es menor a 3000 ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "// 2) Relectura de la BD: estado actualizado, cuenta acreditada con",
                  "//    capital + interes y movimiento de credito registrado.",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT d.estado, d.monto, d.interes_generado, c.saldo, \" +",
                  "  \"(SELECT COUNT(*) FROM movimientos m WHERE m.referencia_tipo = 'deposito' AND m.referencia_id = d.id AND m.tipo = 'credito') AS movimientos_credito \" +",
                  "  \"FROM depositos d JOIN cuentas c ON c.id = d.cuenta_id WHERE d.id = $1\",",
                  "  [Number(pm.collectionVariables.get('depositoCreadoId'))]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  const fila = err ? undefined : (res.json().data || [])[0];",
                  "  pm.test(\"La BD confirma el deposito en estado 'cancelado'\", function () {",
                  "    pm.expect(fila, 'no se encontro la fila en la BD').to.not.be.undefined;",
                  "    pm.expect(fila.estado).to.eql('cancelado');",
                  "  });",
                  "  pm.test('La cuenta se acredito con capital + interes prorrateado', function () {",
                  "    const esperado = utils.centavos(pm.variables.get('saldoAntes')) + utils.centavos(fila.monto) + utils.centavos(fila.interes_generado);",
                  "    pm.expect(utils.centavos(fila.saldo)).to.eql(esperado);",
                  "  });",
                  "  pm.test('Se registro el movimiento de credito de la cancelacion', function () {",
                  "    pm.expect(Number(fila.movimientos_credito)).to.eql(1);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/depositos/{{depositoCreadoId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "depositos",
                "{{depositoCreadoId}}",
                "cancelar"
              ]
            },
            "description": "Cancela el deposito creado por 'Constituir deposito'. Test: 200, estado 'cancelado' en la BD, cuenta acreditada con capital + interes y movimiento de credito. Deja la cuenta con su saldo original."
          },
          "response": []
        },
        {
          "name": "Cancelar deposito ya cancelado (validacion negativa)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1) Precondicion en la BD: el deposito ya esta 'cancelado' (lo cancelo el",
                  "//    request anterior). Se guarda el saldo ANTES del reintento.",
                  "const id = Number(pm.collectionVariables.get(\"depositoCreadoId\"));",
                  "if (!id) {",
                  "  // Sin deposito creado en esta corrida no hay nada que cancelar.",
                  "  console.warn(\"depositoCreadoId vacio: fallo 'Constituir deposito'. Se omite el request.\");",
                  "  pm.execution.skipRequest();",
                  "}",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT d.estado, c.saldo, \" +",
                  "  \"(SELECT COUNT(*) FROM movimientos m WHERE m.referencia_tipo = 'deposito' AND m.referencia_id = d.id) AS movimientos \" +",
                  "  \"FROM depositos d JOIN cuentas c ON c.id = d.cuenta_id WHERE d.id = $1\",",
                  "  [id]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  if (err) { console.error(\"Pre-request SQL fallo:\", err); return; }",
                  "  const fila = (res.json().data || [])[0];",
                  "  if (!fila) { console.warn(\"No existe el deposito \" + id + \" (correr la carpeta completa)\"); return; }",
                  "  pm.variables.set(\"estadoAntes\", fila.estado);",
                  "  pm.variables.set(\"saldoAntes\", fila.saldo);",
                  "  pm.variables.set(\"movimientosAntes\", fila.movimientos);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Precondicion: el deposito ya estaba 'cancelado' en la BD\", function () {",
                  "    pm.expect(pm.variables.get('estadoAntes')).to.eql('cancelado');",
                  "});",
                  "pm.test('status 409 - no se puede cancelar dos veces', function () { pm.response.to.have.status(409); });",
                  "pm.test('El error es CONFLICT', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});",
                  "",
                  "const consultaSql = utils.bodySqlRest(",
                  "  \"SELECT d.estado, c.saldo, \" +",
                  "  \"(SELECT COUNT(*) FROM movimientos m WHERE m.referencia_tipo = 'deposito' AND m.referencia_id = d.id) AS movimientos \" +",
                  "  \"FROM depositos d JOIN cuentas c ON c.id = d.cuenta_id WHERE d.id = $1\",",
                  "  [Number(pm.collectionVariables.get('depositoCreadoId'))]",
                  ");",
                  "pm.sendRequest(consultaSql, (err, res) => {",
                  "  const fila = err ? undefined : (res.json().data || [])[0];",
                  "  pm.test('La BD no cambio: estado, saldo y movimientos iguales', function () {",
                  "    pm.expect(fila, 'no se encontro la fila en la BD').to.not.be.undefined;",
                  "    pm.expect(fila.estado).to.eql('cancelado');",
                  "    pm.expect(utils.centavos(fila.saldo)).to.eql(utils.centavos(pm.variables.get('saldoAntes')));",
                  "    pm.expect(Number(fila.movimientos)).to.eql(Number(pm.variables.get('movimientosAntes')));",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v2/depositos/{{depositoCreadoId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v2",
                "depositos",
                "{{depositoCreadoId}}",
                "cancelar"
              ]
            },
            "description": "Caso negativo: reintenta cancelar el mismo deposito. Test: 409 CONFLICT y la BD sin cambios (estado, saldo y movimientos)."
          },
          "response": []
        }
      ]
    }
