  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request Script DE LA COLECCION (icono de la coleccion > pestaña",
          "// \"Scripts\" > \"Pre-request script\"). Corre antes de CADA request, asi que",
          "// es el lugar para declarar UNA sola vez lo que todos reutilizan.",
          "",
          "// 1) Helper reusable para consultar la BD via el sandbox SQL REST v2.",
          "//    Las tablas del curso 2 (cuentas, movimientos, ahorros, depositos)",
          "//    viven en qa_training_v2, por eso se usa /api/v2/sql/select.",
          "//    pm.variables.get resuelve environment > coleccion, asi la apiKey",
          "//    puede venir del environment o de --env-var sin tocar la coleccion.",
          "if (typeof utils === \"undefined\") {",
          "  utils = {",
          "    bodySqlRest: function (sql, params) {",
          "      return {",
          "        url: pm.variables.get(\"baseUrl\") + \"/api/v2/sql/select\",",
          "        method: \"POST\",",
          "        header: {",
          "          \"Content-Type\": \"application/json\",",
          "          \"x-api-key\": pm.variables.get(\"apiKey\")",
          "        },",
          "        body: {",
          "          mode: \"raw\",",
          "          raw: JSON.stringify({ sql: sql, params: params || [] })",
          "        }",
          "      };",
          "    },",
          "    // Los importes numeric llegan como string (\"15899996.00\"): se comparan",
          "    // en centavos enteros para no arrastrar errores de punto flotante.",
          "    centavos: function (valor) {",
          "      return Math.round(Number(valor) * 100);",
          "    }",
          "  };",
          "}",
          "",
          "// 2) Valores por defecto del body de \"Constituir deposito\". Se resetean",
          "//    ANTES DE CADA request; un caso negativo sobreescribe SOLO el campo",
          "//    que le interesa en su propio Pre-request Script.",
          "pm.collectionVariables.set(\"usuarioId\", 1);",
          "pm.collectionVariables.set(\"cuentaId\", 1);",
          "pm.collectionVariables.set(\"monto\", 100000);",
          "pm.collectionVariables.set(\"plazoDias\", 90);",
          "pm.collectionVariables.set(\"tasaAnual\", 10);"
        ]
      }
    }
  ]
