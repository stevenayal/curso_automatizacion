    {
      "name": "Escenario 4 - Cancelar deposito a plazo antes de su vencimiento",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Crea un deposito descartable para cancelar, en vez de cancelar un",
              "// deposito existente de la BD. Su id queda en depositoCancelarId, que es",
              "// la variable que ya usan los tests de este escenario.",
              "pm.sendRequest({",
              "  url: pm.variables.get(\"baseUrl\") + \"/api/v2/depositos\",",
              "  method: \"POST\",",
              "  header: {",
              "    \"Content-Type\": \"application/json\",",
              "    \"x-api-key\": pm.variables.get(\"apiKey\")",
              "  },",
              "  body: {",
              "    mode: \"raw\",",
              "    raw: JSON.stringify({",
              "      usuarioId: Number(pm.collectionVariables.get(\"usuarioId\")),",
              "      cuentaId: Number(pm.collectionVariables.get(\"cuentaId\")),",
              "      monto: 100000,",
              "      plazoDias: 90,",
              "      tasaAnual: 10",
              "    })",
              "  }",
              "}, (err, res) => {",
              "  if (err || res.code !== 201) { console.error(\"No se pudo crear el deposito a cancelar\", err || res.code); return; }",
              "  pm.variables.set(\"depositoCancelarId\", res.json().data.id);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La cancelacion anticipada se procesa correctamente', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Se cancela el deposito solicitado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.id).to.eql(Number(pm.variables.get('depositoCancelarId')));",
              "});",
              "",
              "pm.test('El deposito queda en estado cancelado', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.estado).to.eql('cancelado');",
              "});",
              "",
              "pm.test('La respuesta contiene el capital del deposito', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('monto');",
              "    pm.expect(Number(jsonData.data.monto)).to.be.at.least(0);",
              "});",
              "",
              "pm.test('La respuesta contiene los intereses generados', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('interes_generado');",
              "    pm.expect(Number(jsonData.data.interes_generado)).to.be.at.least(0);",
              "});",
              "",
              "pm.test('La respuesta contiene los dias transcurridos', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('dias_transcurridos');",
              "    pm.expect(Number(jsonData.data.dias_transcurridos)).to.be.at.least(0);",
              "});",
              "",
              "pm.test('La cuenta del cliente recibe el resultado de la cancelacion', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('cuenta');",
              "    pm.expect(jsonData.data.cuenta).to.have.property('saldo');",
              "    pm.expect(Number(jsonData.data.cuenta.saldo)).to.be.at.least(0);",
              "});",
              "",
              "pm.test('El tiempo de respuesta es menor a 3000 ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v2/depositos/{{depositoCancelarId}}/cancelar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "depositos",
            "{{depositoCancelarId}}",
            "cancelar"
          ]
        },
        "description": "BDD de cancelación exitosa (NO es el escenario negativo de rechazo de cancelación anticipada). Esta solicitud cambia el estado del depósito. Utilizar un ID de depósito vigente de prueba distinto de depositoVigenteId, si se desea mantener ejecutable el escenario 1. Ejecutar al final y no repetir sobre el mismo depósito."
      },
      "response": []
    },
    {
