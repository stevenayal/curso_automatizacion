              "pm.sendRequest(consultaSql, (err, res) => {",
              "  if (err) { console.error(\"Pre-request SQL fallo:\", err); return; }",
              "  const fila = (res.json().data || [])[0];",
              "  if (fila) { pm.collectionVariables.set(\"ahorroId\", fila.id); }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Escenario 5: Obtener plan de ahorro por ID",
              "",
