  "item": [
    {
      "name": "04 - Prestamo en mora",
      "item": [
        {
          "name": "GET cuotas vencidas de un prestamo en mora",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {\n    pm.response.to.have.status(200);\n});\n\npm.test('Devuelve solo cuotas vencidas sin fecha de pago', function () {\n    var cuotas = pm.response.json().data;\n    pm.expect(cuotas).to.be.an('array').that.is.not.empty;\n    cuotas.forEach(function (cuota) {\n        pm.expect(cuota.prestamo_id).to.eql(Number(pm.variables.get('prestamo_mora_id')));\n        pm.expect(cuota.estado).to.eql('vencida');\n        pm.expect(cuota.fecha_pago).to.be.null;\n    });\n});\n\npm.test('Responde en menos de 3000 ms', function () {\n    pm.expect(pm.response.responseTime).to.be.below(3000);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v2/prestamos/{{prestamo_mora_id}}/cuotas?estado=vencida",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v2",
                "prestamos",
                "{{prestamo_mora_id}}",
                "cuotas"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "vencida"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
