  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request Script DE LA COLECCION: corre antes de CADA request.",
          "// Aca se declara UNA sola vez el helper para consultar la BD y se",
          "// resetean los campos del body que algun caso necesita variar.",
          "",
          "// 1) Helper reusable: arma el request a /api/v2/sql/select (solo lectura).",
          "//    Uso: pm.sendRequest(utils.bodySqlRest('SELECT ... WHERE id = $1', [id]), cb)",
          "utils = {",
          "  bodySqlRest: function (sql, params) {",
          "    return {",
          "      url: pm.variables.get('base_url') + '/api/v2/sql/select',",
          "      method: 'POST',",
          "      header: {",
          "        'Content-Type': 'application/json',",
          "        'x-api-key': pm.variables.get('api_key')",
          "      },",
          "      body: { mode: 'raw', raw: JSON.stringify({ sql: sql, params: params || [] }) }",
          "    };",
          "  },",
          "  // Devuelve las filas de una respuesta SQL o lanza un error legible.",
          "  filas: function (err, res) {",
          "    if (err) { throw err; }",
          "    if (res.code !== 200) { throw new Error('SQL respondio ' + res.code + ': ' + res.text()); }",
          "    return res.json().data || [];",
          "  }",
          "};",
          "",
          "// 2) Valores por defecto de los campos variables del body. Cada request",
          "//    negativo sobreescribe SOLO la variable que necesita romper.",
          "pm.collectionVariables.set('monto_solicitado', 1200000);",
          "pm.collectionVariables.set('tasa_interes', 12);",
          "pm.collectionVariables.set('plazo_meses', 6);",
          "pm.collectionVariables.set('numero_cuota', 1);"
        ]
      }
    }
  ]
