              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Devuelve al menos una cuota vencida', function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.data.length).to.be.above(0);\r\n});\r\n\r\npm.test('Todas las cuotas devueltas están en estado vencida', function () {\r\n    var jsonData = pm.response.json();\r\n    jsonData.data.forEach(function (cuota) {\r\n        pm.expect(cuota.estado).to.eql('vencida');\r\n    });\r\n});\r\n\r\npm.test('Las cuotas vencidas no tienen fecha de pago registrada', function () {\r\n    var jsonData = pm.response.json();\r\n    jsonData.data.forEach(function (cuota) {\r\n        pm.expect(cuota.fecha_pago).to.be.null;\r\n    });\r\n});\r\n\r\npm.test('Tiempo de respuesta menor a 3000ms', function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(3000);\r\n});"
