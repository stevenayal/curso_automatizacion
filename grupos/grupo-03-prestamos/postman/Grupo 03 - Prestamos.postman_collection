          "script": {
            "type": "text/javascript",
            "exec": [
              "// ── Shared helpers ──────────────────────────────────────────────\nconst status = pm.response.status;\nconst code   = pm.response.code;\nlet jsonData;\n\npm.test(\"Response is valid JSON\", function () {\n    jsonData = pm.response.json();\n});\n\n// ── 2xx – Success shape ─────────────────────────────────────────\nif (code >= 200 && code <= 299) {\n    pm.test(\"Status code is 2xx\", function () {\n        pm.response.to.have.status(code);\n        pm.expect(code).to.be.within(200, 299);\n    });\n\n    const requiredFields = [\"usuarioId\", \"cuentaId\", \"montoSolicitado\", \"plazoMeses\", \"tasaInteres\"];\n    requiredFields.forEach(function(field) {\n        pm.test(\"Response body has field: \" + field, function () {\n            pm.expect(jsonData).to.have.property(field);\n        });\n    });\n\n    pm.test(\"montoSolicitado matches request value\", function () {\n        pm.expect(jsonData.montoSolicitado).to.eql(1000000);\n    });\n\n    pm.test(\"plazoMeses matches request value\", function () {\n        pm.expect(jsonData.plazoMeses).to.eql(1);\n    });\n\n    pm.test(\"Response contains an identifier field (id or prestamoId)\", function () {\n        const hasId = jsonData.hasOwnProperty(\"id\") || jsonData.hasOwnProperty(\"prestamoId\");\n        pm.expect(hasId, \"Expected 'id' or 'prestamoId' in response\").to.be.true;\n    });\n\n    pm.test(\"Response contains a status field (estado or status)\", function () {\n        const hasStatus = jsonData.hasOwnProperty(\"estado\") || jsonData.hasOwnProperty(\"status\");\n        pm.expect(hasStatus, \"Expected 'estado' or 'status' in response\").to.be.true;\n    });\n}\n\n// ── 4xx – Error body assertions ─────────────────────────────────\nif (code >= 400 && code <= 499) {\n    pm.test(\"Status code is 4xx\", function () {\n        pm.expect(code).to.be.within(400, 499);\n    });\n\n    pm.test(\"Error response contains a meaningful error description\", function () {\n        const hasError =\n            jsonData.hasOwnProperty(\"error\")   ||\n            jsonData.hasOwnProperty(\"message\") ||\n            jsonData.hasOwnProperty(\"errors\")  ||\n            jsonData.hasOwnProperty(\"detail\");\n        pm.expect(hasError, \"Expected at least one of: error, message, errors, detail\").to.be.true;\n    });\n\n    pm.test(\"Error description is non-empty\", function () {\n        const desc = jsonData.error || jsonData.message || jsonData.detail ||\n                     (Array.isArray(jsonData.errors) ? jsonData.errors[0] : jsonData.errors);\n        pm.expect(desc).to.not.be.undefined;\n        pm.expect(desc).to.not.be.null;\n        if (typeof desc === \"string\") {\n            pm.expect(desc.trim().length).to.be.above(0);\n        }\n    });\n\n    if (code === 400 || code === 422) {\n        pm.test(\"400/422: error relates to montoSolicitado=0 or missing plazoMeses\", function () {\n            const bodyStr = JSON.stringify(jsonData).toLowerCase();\n            const mentionsField =\n                bodyStr.includes(\"montosolicitado\") ||\n                bodyStr.includes(\"monto\")           ||\n                bodyStr.includes(\"plazomeses\")      ||\n                bodyStr.includes(\"plazo\")           ||\n                bodyStr.includes(\"required\")        ||\n                bodyStr.includes(\"invalid\")         ||\n                bodyStr.includes(\"requerido\")       ||\n                bodyStr.includes(\"inválido\");\n            pm.expect(mentionsField, \"Error body should mention the offending field or validation rule\").to.be.true;\n        });\n    }\n}"
