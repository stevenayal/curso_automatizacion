# .env.ai.example — presupuesto de agentes IA
# Copiar a .env.ai (gitignored). Valores iniciales: ajustar con métricas reales del proyecto.
# Generado por skill playwright-ai-agents · aiquaa.com

# Healer: intentos automáticos por test antes de HUMAN_REVIEW_REQUIRED (máx recomendado 3)
AI_MAX_HEAL_ATTEMPTS=2

# Llamadas al modelo por test (plan + generate + heal suman acá)
AI_MAX_CALLS=3

# Tope interno de tokens (input + output) por test generado o reparado
AI_MAX_TOKENS=40000

# Presupuesto en moneda del proveedor por test — definir según tarifa real
AI_BUDGET_PER_TEST=

# Tier de modelo por defecto: economico | intermedio | avanzado
AI_DEFAULT_TIER=economico
